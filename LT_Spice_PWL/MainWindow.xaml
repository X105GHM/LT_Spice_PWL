<Window x:Class="PwlEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PwlEditor.Controls"
        Icon="pack://application:,,,/Assets/app.ico"
        mc:Ignorable="d"
        Title="LTspice PWL Editor"
        Width="1380"
        Height="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}">
            <ToolBar Background="{DynamicResource ToolbarBackgroundBrush}">
                <Button Content="Neu" Click="New_Click"/>
                <Separator/>
                <Button Content="Projekt öffnen" Click="OpenProject_Click"/>
                <Button Content="Projekt speichern" Click="SaveProject_Click"/>
                <Separator/>
                <Button Content="PWL importieren" Click="ImportPwl_Click"/>
                <Button Content="PWL exportieren" Click="ExportPwl_Click"/>
                <Separator/>
                <Button Content="LaTeX exportieren" Click="ExportLatex_Click"/>
                <Separator/>
                <TextBlock VerticalAlignment="Center" Margin="8,0,4,0" Text="Theme:"/>
                <ComboBox x:Name="ThemeComboBox"
                          Width="120"
                          SelectionChanged="ThemeComboBox_SelectionChanged" Background="{Binding ElementName=comboBoxItem, Mode=OneWay}">
                    <ComboBoxItem x:Name="comboBoxItem" Content="Light" IsSelected="True"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Signal / Achsen">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Periodendauer"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="PeriodDurationTextBox" Width="90" Text="1.0" PreviewMouseWheel="PeriodDurationTextBox_PreviewMouseWheel"/>
                                <ComboBox x:Name="PeriodUnitComboBox" Width="70" Margin="6,4,0,4">
                                    <ComboBoxItem Content="s"/>
                                    <ComboBoxItem Content="ms" IsSelected="True"/>
                                    <ComboBoxItem Content="us"/>
                                    <ComboBoxItem Content="ns"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Gesamtdauer Export"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TotalDurationTextBox" Width="90" Text="10.0"/>
                                <ComboBox x:Name="TotalDurationUnitComboBox" Width="70" Margin="6,4,0,4">
                                    <ComboBoxItem Content="s"/>
                                    <ComboBoxItem Content="ms" IsSelected="True"/>
                                    <ComboBoxItem Content="us"/>
                                    <ComboBoxItem Content="ns"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="V/div"/>
                            <TextBox x:Name="VoltsPerDivTextBox" Grid.Row="2" Grid.Column="1" Margin="4,0,0,8" Text="1.0" PreviewMouseWheel="VoltsPerDivTextBox_PreviewMouseWheel"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Offset [V]"/>
                            <TextBox x:Name="YOffsetTextBox" Grid.Row="3" Grid.Column="1" Margin="4,0,0,8" Text="0.0" PreviewMouseWheel="YOffsetTextBox_PreviewMouseWheel"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Snap Zeit"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="SnapXTextBox" Width="90" Text="0.05" PreviewMouseWheel="SnapXTextBox_PreviewMouseWheel"/>
                                <ComboBox x:Name="SnapXUnitComboBox" Width="70" Margin="6,4,0,4">
                                    <ComboBoxItem Content="s"/>
                                    <ComboBoxItem Content="ms" IsSelected="True"/>
                                    <ComboBoxItem Content="us"/>
                                    <ComboBoxItem Content="ns"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Snap Spannung [V]"/>
                            <TextBox x:Name="SnapYTextBox" Grid.Row="5" Grid.Column="1" Margin="4,4,4,4" Text="0.05" PreviewMouseWheel="SnapYTextBox_PreviewMouseWheel"/>

                            <CheckBox x:Name="SnapEnabledCheckBox"
                                      Grid.Row="6"
                                      Grid.ColumnSpan="2"
                                      Content="Snapping aktiv"
                                      IsChecked="True"
                                      Margin="0,4,0,0"/>

                            <Button Grid.Row="7"
                                    Grid.ColumnSpan="2"
                                    Width="140"
                                    Margin="80,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="Auto aus Punkten"
                                    Click="AutoFromPoints_Click"/>
                            
                            <Button Grid.Row="8"
                                    Grid.ColumnSpan="2"
                                    Width="140"
                                    Margin="80,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="Auto aus Formel"
                                    Click="AutoFromFormula_Click"/>

                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Werkzeuge">
                        <StackPanel Margin="10">
                            <WrapPanel Margin="0,0,0,8">
                                <Button Width="160" Margin="0,0,8,8" Content="Einstellungen anwenden" Click="ApplySettings_Click"/>
                                <Button Width="160" Margin="0,0,0,8" Content="Standardpunkte laden" Click="LoadDefaultPoints_Click"/>
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}">
                                Linksklick: Punkt setzen/ziehen. Rechtsklick: exakte XY-Eingabe. Entf: markierten Punkt löschen.
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <TabControl Margin="0,0,0,10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}">
                        <TabItem Header="Formel">
                            <StackPanel Margin="10">
                                <TextBlock Text="Formel (Variable: t, Konstanten: pi, e, i)" Margin="0,0,0,6"/>
                                <TextBox x:Name="FormulaTextBox"
                                         Height="70"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="sin(2*pi*t)"
                                         PreviewKeyDown="FormulaTextBox_PreviewKeyDown"/>

                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Ausgabe-Modus"/>
                                    <ComboBox x:Name="OutputModeComboBox" Grid.Row="0" Grid.Column="1" Margin="4,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Samples / Periode"/>
                                    <TextBox x:Name="SamplesPerPeriodTextBox" Grid.Row="1" Grid.Column="1" Text="500"/>
                                </Grid>

                                <Button Width="190" Content="Formel in Punkte umwandeln" Click="ApplyFormula_Click"/>

                                <TextBlock Margin="0,14,0,6" FontWeight="SemiBold" Text="LaTeX-Vorschau"/>
                                <TextBox x:Name="LatexPreviewTextBox"
                                         Height="95"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Punkte">
                            <StackPanel Margin="10">
                                <TextBlock Text="Punktliste" Margin="0,0,0,6"/>
                                <DataGrid x:Name="PointsDataGrid"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F6}" Width="*"/>
                                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F6}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource PanelBackgroundBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <controls:WaveEditorControl x:Name="WaveEditor" Grid.Row="0" MinHeight="500"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource InfoTextBrush}"
                               TextWrapping="Wrap">
                        Exportiert wird die gezeichnete Periode als wiederholtes LTspice-PWL-Signal bis zur Gesamtdauer.
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Bereit"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>